{
  "expo": {
    "name": "Plantdoku",
    "slug": "plantdoku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F6EA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mithatcanturan.plantdoku",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F6EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mithatcanturan.plantdoku"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F6EA"
        }
      ],
      "expo-localization",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#69C938"
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-4604843322018757~5047930621",
          "androidAppId": "ca-app-pub-4604843322018757~8222823109",
          "userTrackingUsageDescription": "This lets us show ads that are more relevant to you. Plantdoku works exactly the same either way.",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b29a2752-0527-4cb3-8f41-d60690d8fedb"
      }
    }
  }
}
